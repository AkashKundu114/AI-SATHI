# ==============================================================================
# AI-SATHI Environment Configuration
# Domain: https://kothakhata.app
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Web Platform & Authentication (REQUIRED)
# ------------------------------------------------------------------------------
PUBLIC_BASE_URL=https://kothakhata.app
JWT_SECRET_KEY=change_this_to_a_long_random_secret_string_for_jwt_tokens
ADMIN_PASSWORD=admin

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL) (REQUIRED)
# ------------------------------------------------------------------------------
POSTGRES_USER=aisathi
POSTGRES_PASSWORD=generate_a_secure_db_password_here
POSTGRES_DB=aisathi
DATABASE_URL=postgresql+asyncpg://aisathi:generate_a_secure_db_password_here@postgres:5432/aisathi

# ------------------------------------------------------------------------------
# 3. Sarvam AI Models (REQUIRED)
# ------------------------------------------------------------------------------
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_BASE_URL=https://api.sarvam.ai

SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_ADVANCED_MODEL=sarvam-105b
SARVAM_CONVERSATIONAL_MODEL=sarvam-105b-conversations
SARVAM_TRANSLATION_MODEL=mayura:v1
SARVAM_VISION_MODEL=Vision
SARVAM_PARSE_MODEL=Parse
SAARAS_MODEL=saaras:v4
SAARAS_FALLBACK_MODEL=saaras:v3
ROUTINE_CONFIDENCE_FLOOR=0.80

# ------------------------------------------------------------------------------
# 4. Microsoft Azure Blob Storage (Document & Asset Hosting)
# ------------------------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=aisathi-assets

# ------------------------------------------------------------------------------
# 5. Observability & Tracing (Langfuse)
# ------------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ------------------------------------------------------------------------------
# 6. Asset Fonts & Safety Limits
# ------------------------------------------------------------------------------
BENGALI_FONT_PATH=assets/fonts/NotoSansBengali-Bold.ttf
DEBUG=false
MAX_MESSAGES_PER_HOUR=30
SESSION_TTL_SECONDS=1800
MAX_TEXT_MESSAGE_CHARS=2000
