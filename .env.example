# --- WhatsApp Cloud API (Meta) ---
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=
WA_WEBHOOK_VERIFY_TOKEN=
WA_APP_SECRET=
WA_PUBLIC_PHONE_NUMBER=
PUBLIC_BASE_URL=

# --- WhatsApp Flows (optional) ---
WA_LEDGER_CONFIRM_FLOW_ID=

# --- Postgres (local container, just set a password) ---
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://aisathi:changeme@postgres:5432/aisathi

# --- Object storage: Azure Blob Storage ---
# In Azure: the real Storage Account connection string, put in Key Vault
# by infra/main.bicep and injected as a Container App secret automatically.
# For LOCAL dev only, point this at the Azurite emulator container in
# docker-compose.yml:
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;
AZURE_STORAGE_CONTAINER=aisathi-assets

# ============================================================
# REQUIRED — sole AI vendor
# ============================================================
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_CHAT_MODEL=sarvam-30b
SARVAM_ADVANCED_MODEL=sarvam-105b
SARVAM_VISION_MODEL=sarvam-vision
SAARAS_MODEL=saaras:v3

# ============================================================
# OPTIONAL — safe to leave blank/default
# ============================================================

# Local model fallback: left OFF by design in the Azure low-cost
# deployment. A GPU box costs far more per month than this pilot's entire
# Sarvam bill at 100 users / ~2,000 msgs/day. Leave false unless you
# genuinely provision your own GPU infra later.
USE_LOCAL_MODELS=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
ROUTINE_CONFIDENCE_FLOOR=0.80
SARVAM_LOCAL_BASE_URL=

BENGALI_FONT_PATH=assets/fonts/NotoSansBengali-VariableFont_wdth,wght.ttf

FLUX_API_KEY=
FLUX_BASE_URL=https://api.bfl.ml

DATA_GOV_IN_API_KEY=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000

DEBUG=false
MAX_MESSAGES_PER_HOUR=30
SESSION_TTL_SECONDS=1800

# --- Metrics Monitoring & Email Alerts ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
METRICS_ALERT_EMAIL=admin@example.com
ADMIN_API_TOKEN=generate_random_secret_token_here

